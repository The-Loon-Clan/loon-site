# Local agent/editor configuration — per-developer, not per-project.
.claude/

# Python bytecode from the tooling in scripts/.
__pycache__/
*.pyc

# Scratch. Anything named _tmp* is a working file from a session, not source.
_tmp*

# Reference screenshots and the comparison sheets the UI tooling writes.
# target_*.png are inputs worth keeping; everything the tools generate is not.
refs/_*.png
refs/_focus.json

# Built binaries.
/loonsite
/loonsite.exe

# Local multi-module development against sibling checkouts. go.work.example is
# committed and explains it; the file itself is per-developer, and committing
# one would make everybody else's build depend on directories they do not have.
go.work
go.work.sum

# Coverage profiles. `make cover` writes one on every run and `make clean`
# removes it; one slipped into a commit because neither was true of a run done
# by hand.
coverage.out
*.cover
