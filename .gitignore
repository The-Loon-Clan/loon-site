# Local agent/editor configuration — per-developer, not per-project.
.claude/

# Python bytecode from the tooling in scripts/.
__pycache__/
*.pyc

# Scratch. Anything named _tmp* is a working file from a session, not source.
_tmp*

# Reference screenshots and the comparison sheets the UI tooling writes.
# target_*.png are inputs worth keeping; everything the tools generate is not.
refs/_*.png
refs/_focus.json

# Built binaries.
/loondemo
/loondemo.exe
