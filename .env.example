# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# docker-compose.yml reads .env automatically, so `make run` picks these up
# with nothing else to do.
#
# ── generating a key ────────────────────────────────────────────────────
#
# Every secret below is a 512-bit key. One command, run once per secret:
#
#   openssl rand -hex 64
#
# 64 bytes of randomness, hex-encoded to 128 characters. If openssl is not to
# hand:
#
#   head -c 64 /dev/urandom | xxd -p -c 128
#   python3 -c "import secrets; print(secrets.token_hex(64))"
#   pwsh:  -join ((1..64 | % { '{0:x2}' -f (Get-Random -Max 256) }))
#
# 512 bits is more than any of these strictly need — a session HMAC is fine at
# 256. It is one number so there is one command and no per-secret judgement
# call, and the cost of the extra bytes is nothing.
#
# NEVER reuse a key between two variables, and never between environments. A
# key that leaks should cost exactly one thing.


# ── secrets ─────────────────────────────────────────────────────────────

# Signs the session cookie. Changing it signs every member out, which is the
# emergency action if you ever believe it has leaked.
#
# The code falls back to a placeholder marked "dev-insecure" when this is
# unset, so a demo runs out of the box. That fallback is not a default — it is
# a signal, and a deployment that keeps it has an unsigned front door.
LOON_SESSION_SECRET=

# Gates the pprof listener (see docs/OPERATING.md).
#
# UNSET = the listener never starts, which is the safe state. Shorter than 64
# characters and it refuses to start too, and says so — a heap dump carries
# live data and /debug/pprof/profile is a CPU denial of service, so a weak
# token here is worse than no profiling.
LOON_PPROF_TOKEN=
LOON_PPROF_ADDR=127.0.0.1:6060


# ── third-party credentials ─────────────────────────────────────────────
#
# These are issued by somebody else, so they are whatever length that service
# chose. Left blank the feature is simply absent: no TMDB key means no metadata
# lookups rather than a broken page, which is the pattern every optional source
# in this codebase follows.

TMDB_API_KEY=
TPDB_API_KEY=

# Cloudflare Turnstile. Both or neither — one alone disables the captcha.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=


# ── deployment ──────────────────────────────────────────────────────────

# Used for absolute URLs the site cannot infer: the sitemap, and the Sitemap
# line in robots.txt, which a crawler is entitled to ignore if it is relative.
LOON_BASE_URL=http://localhost:8090

# Marks the session and CSRF cookies Secure. Set to 1 behind TLS; leaving it
# unset on an https deployment means cookies that travel in the clear the first
# time somebody types the http address.
SECURE_COOKIES=


# ── optional features ───────────────────────────────────────────────────
#
# All off unless set. Each is off for its own reason, not out of caution, and
# the reason is on the flag.

# The BitTorrent tracker. Unlike everything else here it is not inert until
# somebody visits it: switching it on publishes announce endpoints, mints a
# passkey per member and starts keeping ratio accounting. Set it deliberately.
#
# It also seeds a demo catalogue on first boot — a torrent per category, made
# from releases already in your index — so /tracker has something in it. No
# releases indexed means no torrents, which is the honest answer rather than a
# list of invented titles. See web/handlers/demoseedtracker_web.go.
LOON_TRACKER=

# The absolute base baked into every .torrent's announce URL. Defaults to
# LOON_BASE_URL's value; set it if the address a torrent client must reach
# differs from the one people browse on. A wrong value here does not fail
# loudly — it produces torrents pointing somewhere unable to answer, and the
# member finds out when their client reports the tracker dead.
LOON_SITE_URL=

# Rules that sit OVER the tracker's accounting, each on its own flag because
# each is a separate decision. Hit-and-run disables a member's downloads;
# seedlock restricts which machine may seed; cheat detection judges the
# counters. None of them does anything without LOON_TRACKER.
LOON_HITRUN=
LOON_SEEDLOCK=
LOON_CHEATCHECK=

# Donations. DEV-ONLY: the plugin takes real money through BTCPay, so this env
# flag is the outer gate and the admin toggle sits inside it.
LOON_DONATIONS=

# The /dev template inspector. Serves template sources, so it stays off
# anywhere that is not a laptop.
LOON_UI_INSPECT=
