;(function(){const getLang=function(key,fallback){if(typeof ips!=='undefined'&&ips.getString){return ips.getString(key)||fallback;}
return fallback;};const applyToInput=function(input){if(input.dataset.passwordviewer){return;}
input.dataset.passwordviewer='1';const wrapper=document.createElement('span');wrapper.className='passwordviewer';input.parentNode.insertBefore(wrapper,input);wrapper.appendChild(input);const button=document.createElement('button');button.type='button';button.className='passwordviewer__toggle';const labelText=getLang('passwordviewer_toggle_password','Show or hide password');button.setAttribute('aria-label',labelText);button.setAttribute('title',labelText);button.setAttribute('data-ipsTooltip','');button.innerHTML='<i class="fa-regular fa-eye"></i>';wrapper.appendChild(button);};const init=function(root){root=root||document;root.querySelectorAll('input[type="password"]').forEach(function(input){applyToInput(input);});};document.addEventListener('click',function(e){const button=e.target.closest('.passwordviewer__toggle');if(!button){return;}
e.preventDefault();e.stopPropagation();const wrapper=button.closest('.passwordviewer');if(!wrapper){return;}
const input=wrapper.querySelector('input');if(!input){return;}
const visible=input.getAttribute('type')==='text';input.setAttribute('type',visible?'password':'text');button.innerHTML=visible?'<i class="fa-regular fa-eye"></i>':'<i class="fa-regular fa-eye-slash"></i>';},true);document.addEventListener('DOMContentLoaded',function(){init(document);});document.addEventListener('ipsContentLoaded',function(e){init(e.target||document);});const observer=new MutationObserver(function(mutations){mutations.forEach(function(mutation){mutation.addedNodes.forEach(function(node){if(node.nodeType!==1){return;}
if(node.matches&&node.matches('input[type="password"]')){applyToInput(node);}
if(node.querySelectorAll){init(node);}});});});observer.observe(document.documentElement,{childList:true,subtree:true});})();;