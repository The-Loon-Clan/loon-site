	<div class='buzzVideo {{#isShorts}}youtubeShorts{{/isShorts}}'>
		{{#img}}
			{{#blankImage}}
				<img src='{{blankImage}}' data-src='{{img}}' class='lazyload'>
			{{/blankImage}}
			{{^blankImage}}
				<img src='{{img}}'>
			{{/blankImage}}
			<a href='#' data-action='playVideoInIframe'></a>
		{{/img}}
		{{^img}}
			{{#html5}}
				<video class='buzzPlayer' width='100%' height='100%' controls>
					<source src='{{play}}' autostart='false'>
				</video>
			{{/html5}}
			{{^html5}}
				<iframe class='buzzPlayer' width='100%' height='100%' src='{{play}}' frameborder='0' allow='autoplay; encrypted-media' allowfullscreen></iframe>
			{{/html5}}
		{{/img}}
	</div>
	<a class='buzzVideoPopupOpen' data-action='playVideoInPopup'>
		<i class='fa fa-window-maximize' aria-hidden='true'></i>&nbsp;&nbsp;{{#lang}}buzz_expandPlayer{{/lang}}
	</a>
</div>
`);ips.templates.set('buzz.videoIframe',` 
