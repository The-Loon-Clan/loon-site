	{{/blankImage}}
	{{^blankImage}}
		<img src='{{url}}' alt=''>
	{{/blankImage}}
</a>
`);ips.templates.set('buzz.parseURL',`
    <a href='{{url}}' target='_blank' class='buzzURL' rel='noopener noreferrer'>{{text}}</a>
`);ips.templates.set('buzz.parseVideo',` 
