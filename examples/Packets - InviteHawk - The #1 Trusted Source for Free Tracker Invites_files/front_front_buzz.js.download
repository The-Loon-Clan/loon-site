	</span>
</div>
`);ips.templates.set('buzz.chatters.list',` 
<ul class='ipsMenu ipsMenu_normal menuChatters' id='chattersList_{{roomID}}_menu' style='display: none'>
	<li class='ipsMenu_title'>{{#lang}}buzz_online_users{{/lang}}</li>
