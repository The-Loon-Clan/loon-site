				{{#id}}
					{{#canManageMSG}}
						<a class='msgAction' href='#msgAction{{id}}_menu' id='msgAction{{id}}' data-action='options' data-ipsMenu data-ipsMenu-closeOnClick='false' data-ipsMenu-appendTo='.buzzContainer'>
							<i class='fa fa-ellipsis-h'></i>
