ips.templates.set('liveactivity.notification.item',`
	<div class="liveactivity_item liveactivity_item_{{style}} liveactivity_app_{{app}} ipsBox ripple" data-url="{{url}}" style="cursor: pointer;">
		{{#author_photo}}
		<div class="liveactivity_avatar">
			{{#author_url}}<a href="{{author_url}}">{{/author_url}}
				<img src="{{author_photo}}" alt="{{author_name}}">
			{{#author_url}}</a>{{/author_url}}
		</div>
		{{/author_photo}}
		<div class="liveactivity_content">
			<div class="liveactivity_content_inner">
				<span class="liveactivity_author">
					{{#author_url}}<a href="{{author_url}}">{{/author_url}}
						{{author_name}}
					{{#author_url}}</a>{{/author_url}}
				</span>
				<span class="liveactivity_text">{{{contentText}}}</span>
			</div>
		</div>
	</div>
`);;